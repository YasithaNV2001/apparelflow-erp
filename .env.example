# Copy this file to .env.local and fill in real values. .env.local is git-ignored; never commit it.

# Supabase → Connect → Transaction pooler (port 6543). Used by the app at runtime.
DATABASE_URL="postgresql://postgres.<project-ref>:<db-password>@<pooler-host>:6543/postgres?sslmode=require"

# Supabase → Connect → Session pooler (port 5432). Used only by `npm run db:migrate`.
DATABASE_URL_MIGRATIONS="postgresql://postgres.<project-ref>:<db-password>@<pooler-host>:5432/postgres?sslmode=require"

# Signs the session cookie. 32 random bytes in base64; generate your own with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET="<paste-a-freshly-generated-secret>"
